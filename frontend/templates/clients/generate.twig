{# generate.twig #}

{% extends 'base/main.twig' %}

{% block title %}Clients Diagram{% endblock %}

{% block content %}
    <div class="container mt-5">
        <!-- First Block -->
        <div class="text-dark p-3 mb-3">
            <div class="d-flex align-items-center justify-content-center px-2">
                <div class="text-center">
                    <h2>Generate clients data</h2>
                    <div class="row g-2" >
                        <div class="col-md-6">
                            <input type="number" class="form-control" min="1" max="2000" id="count" name="count" placeholder="count">
                        </div>
                        <div class="col-md-6">
                            <button class="btn btn-primary" id="generate">Generate</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Second Block -->
        <div class="text-white p-3 mb-3">
            <div id="result">
                {% include 'clients/generate/result.twig' %}
            </div>
        </div>
    </div>

    <script src="/frontend/js/generate.js"></script>

{% endblock %}